<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDisplayName</key><string>LeoMoon QuickCrypt</string>
    <key>CFBundleExecutable</key><string>LeoMoon QuickCrypt</string>
    <key>CFBundleIconFile</key><string>main.icns</string>
    <key>CFBundleIdentifier</key><string>com.leomoon.QuickCrypt</string>
    <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
    <key>CFBundleName</key><string>LeoMoon QuickCrypt</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleShortVersionString</key><string>@VERSION@</string>
    <key>CFBundleVersion</key><string>@VERSION@</string>
    <key>CFBundleDocumentTypes</key>
